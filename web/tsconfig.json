{
  "extends": "@dify/tsconfig/nextjs.json",
  "compilerOptions": {
    "incremental": true,
    "paths": {
      "@/*": ["./*"],
      "~@/*": ["./*"]
    },
    "resolveJsonModule": true,
    "types": ["vite-plus/test/globals", "node"],
    "allowImportingTsExtensions": true,
    "allowJs": true
  },
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.browser.json"
    }
  ],
  "files": [],
  "include": [],
  "exclude": ["node_modules"]
}
